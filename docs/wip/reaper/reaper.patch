--- a/modules/stdlib/Ktc2Internal.kt
+++ b/modules/stdlib/Ktc2Internal.kt
@@ -248,6 +248,13 @@ public external fun arrayKind(value: Any?): Int
 /** The weak cell of [target]: refers to it without keeping it alive. Null for null. */
 public external fun weakCell(target: Any?): Any?
 
+/**
+ * Checks the group of objects of declared cycles and rings the target of [cell] (a [weakCell]) is in, and frees it when
+ * nothing else holds any of it: true when the target is gone. For a module that knows when its objects may be left in
+ * cycles (the reaper of kotlinx.coroutines); a program whose classes are of no declared cycle or ring has none.
+ */
+public external fun collectGroupOf(cell: Any?): Boolean
+
 /** The target of a weak [cell], or null once it has been destroyed. */
 public external fun weakGet(cell: Any?): Any?
 
diff --git a/modules/stdlib/runtime/ktc2_core.c b/modules/stdlib/runtime/ktc2_core.c
index 9010e30f..1bc0a0d2 100644
--- a/modules/stdlib/runtime/ktc2_core.c
+++ b/modules/stdlib/runtime/ktc2_core.c
@@ -651,6 +651,7 @@ static ktc2_Obj* group_collect(ktc2_Obj* start, bool knots, uint32_t most, bool*
 	return start;
 }
 
+
 #endif
 
 void ktc2_pair_check(ktc2_Obj* object, uint32_t left)
@@ -2760,6 +2761,34 @@ ktc2_Obj* ktc2_weakGet(ktc2_Obj* object)
 	return target;
 }
 
+#ifdef KTC2_KNOTS
+bool ktc2_collectGroupOf(ktc2_Obj* cell)
+{
+	if (!cell) return true;
+#ifdef KTC2_THREADS
+	/* In the step of the checks of pairs: one at a time, and no weak reference is read meanwhile. */
+	while (ktc2_atomic_exchange(&pair_checking, 1)) thread_yield();
+#endif
+	runtime_enter();
+	ktc2_Obj* target = ((WeakCell*)cell)->target;
+	/* Gone, or going (its last release is being made on another thread): nothing to check. */
+	uint32_t left = target ? KTC2_RC_LOAD(target) & KTC2_COUNT_MASK : 0;
+	bool gone = left == 0;
+	ktc2_Obj* freed = NULL;
+	/*
+	 * Only as a release would check it: when what holds it is no more than its own cycles. Held by more, another thread
+	 * may be using it and changing what the walk would read (adding a handler to its list).
+	 */
+	if (!gone && left <= ktc2_types[target->typeId].pairs && ktc2_type_ring_refs[target->typeId]) freed = ktc2_knot_collect(target);
+	runtime_leave();
+#ifdef KTC2_THREADS
+	ktc2_atomic_exchange(&pair_checking, 0);
+#endif
+	if (freed) ktc2_release(freed);
+	return gone || freed != NULL;
+}
+#endif
+
 void ktc2_weak_cell_destroy(ktc2_Obj* object)
 {
 	WeakCell* cell = (WeakCell*)object;
