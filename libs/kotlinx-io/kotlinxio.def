# The C that ktc2's part of kotlinx-io calls (Ktc2KotlinxIoFiles.kt): what differs between Windows
# and the other systems, in kotlinxio.h. The declarations of Windows it needs are in
# kotlinxio_win32.h, which is not listed here: they get no binding.
package = ktc2.kotlinxio
headers = kotlinxio.h
# glibc hides what is not ISO C under -std=c11 (realpath, strdup, O_CLOEXEC) unless asked before any header.
compilerOpts.linux = -D_DEFAULT_SOURCE
